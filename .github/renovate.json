{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "extends": [
      "schedule:weekly"
    ],
    "automerge": true,
    "automergeType": "pr",
    "platformAutomerge": false
  },
  "nix": {
    "enabled": true
  },
  "ignoreDeps": [
    "wallpapers-nix",
    "darwin",
    "home-manager"
  ]
}
